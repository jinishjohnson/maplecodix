# ==============================================================================
# MapleCodix Digital Studio - Environment Variables Template
# Copy this file to .env and insert your real production secrets
# ==============================================================================

# Google Gemini AI API Key (Get yours at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend REST / Webhook API Endpoint
VITE_API_BASE_URL=https://api.maplecodix.com/v1

# 24*7 Support & Communication Hotlines
VITE_WHATSAPP_PHONE=15063124135
VITE_SUPPORT_EMAIL=support@maplecodix.com
VITE_SUPPORT_PHONE=+1 (506) 312-4135

# Client-Side AES-256 GCM Cryptography Key & Status
VITE_DATA_ENCRYPTION_KEY=replace_with_64_char_hex_secret
VITE_ENABLE_ENCRYPTION=true

# Web3Forms Email Submission Access Key (Get yours at https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Canonical Site URL
VITE_SITE_URL=https://maplecodix.com
